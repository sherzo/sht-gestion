# Copiar a .env para desarrollo local. Nunca subir .env al repositorio.
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://sht:sht@localhost:5432/sht
# Orígenes permitidos para el frontend (separados por coma).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Firma de los tokens de acceso (ADR-0005). En local cualquier cadena larga; en
# producción viene del secreto jwt-secret de Secret Manager.
JWT_SECRET=cambiar-por-una-cadena-aleatoria-larga-solo-para-desarrollo
# Código de instalación del primer administrador (FR-001). Sin él, la instalación
# queda deshabilitada.
SETUP_CODE=codigo-local
# Cookie del token de renovación (research R5): en local lax y sin Secure; en
# producción provisional none + Secure; con dominio propio strict + Secure.
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SECURE=false
